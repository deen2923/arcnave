# HTTPS for ARCNAVE. DOMAIN comes from deploy/.env (e.g. arcnave.duckdns.org).
# Caddy gets and renews the Let's Encrypt certificate by itself (ports 80 and 443 must be open).
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy arcnave:8080 {
		# long SPHEREx downloads (the server waits up to 180 s for IRSA)
		transport http {
			read_timeout 240s
			write_timeout 240s
		}
	}
}
