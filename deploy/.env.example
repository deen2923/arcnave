# Copy to deploy/.env on the server and fill in. Never commit deploy/.env (it is in .gitignore).
# Your site's address (no https://, no slash), e.g. sky.arcnave.in or arcnave.duckdns.org
DOMAIN=sky.arcnave.in
# Only for compose.tunnel.yaml (Cloudflare Tunnel): the token Cloudflare shows when you create the tunnel
TUNNEL_TOKEN=
